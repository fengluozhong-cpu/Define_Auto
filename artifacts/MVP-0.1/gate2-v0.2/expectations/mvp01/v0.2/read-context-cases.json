    {"case_id": "M01-RC29", "title": "Count change with same XPT invalidates dependent decision and downstream", "base": "dm", "procedure": ["Create only isolated synthetic decision/validation/approval bound to count-3 read context and actual provenance hashes.", "Use fresh, properly bound declaration/provenance asserting compatible count 4; retain exact same XPT bytes.", "Attempt prior decision reuse and evaluate dependency impact."], "expected": {"xpt_hash_unchanged": true, "dependency_snapshot_changed": true, "changed_dependency_names_include": ["read_context", "read_context_provenance"], "decision_validity": "needs_review", "automatic_apply": false, "dependent_validation_validity": "needs_review", "dependent_approval_validity": "needs_review", "old_history_unchanged": true, "impact_objects_include": ["study/SYN001/family/SDTM/dataset/DM"]}},
