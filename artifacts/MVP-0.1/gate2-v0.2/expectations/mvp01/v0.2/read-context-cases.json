  "interpretation": {
    "outcome": "read_success or reject is the normative logical result, not a required public API spelling or error-code name",
    "reject": "No successful reliable row_count/statistical assertions. Preserve a locating diagnostic and distinguish input/context failure from a measured zero-row dataset. CLI may return failed run or dataset unreadable/gap, but must block treating this input as successful.",
    "default_mode": "isolated_test",
    "default_scope": {"study_id": "SYN001", "family": "SDTM"},
    "default_encoding_when_no_declaration": "ascii supplied explicitly by effective reader configuration, never inferred",
    "mutations": "Each case starts from its named fresh baseline. JSON paths refer to the context unless source_document or xpt_bytes is named. A one-declaration context is used, so unrelated VS/DM declarations cannot cause an absent-target failure. Mutations are not cumulative across cases.",
    "provenance_binding": "SourceArtifact registry explicitly maps provenance.source_id to the named accessible source file. Its actual bytes hash must match provenance.source_sha256. Do not discover sources by directory enumeration.",
    "truth_limitation": "A compatible declared count is external evidence, not proven by bytes. In successful declared-count cases preserve declaration_id, source/provenance hashes and locator, row_count_basis=delivery_declaration, padding_bytes and trusted_delivery_declaration_not_independently_verified. Never add approved assertions from a read declaration.",
    "new_ids": "Valid modified declarations and modified source documents use fresh TEST declaration/source IDs; negative duplicate-ID cases intentionally violate this. Original declaration records are never overwritten.",
    "dependency_test_authorization": "Use only isolated synthetic decisions, validations and approvals. No real business approval is created by these cases."
  },
